
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Next.js server data cache (set false to bypass during incident/debugging)
CACHE_ENABLED=true

# Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canvas LMS
# Default host shown in the connect form; users supply their own access token.
CANVAS_API_URL=https://canvas.instructure.com
# Encrypts per-user Canvas tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Local development only: allow the shared CANVAS_ACCESS_TOKEN fallback.
CANVAS_ALLOW_ENV_TOKEN=false
CANVAS_ACCESS_TOKEN=

# RAG service (../rag/canvas-ai-assistant)
RAG_API_URL=http://localhost:8000
RAG_API_TOKEN=
RAG_ADMIN_TOKEN=
RAG_TIMEOUT_MS=30000
# Exact-match answer cache; enable after internal validation.
RAG_ANSWER_CACHE_ENABLED=false
# Optional comma-separated internal app user IDs for staged rollout.
RAG_ANSWER_CACHE_USER_IDS=
# Protects /api/admin/cache-metrics. Falls back to CRON_SECRET when empty.
CACHE_METRICS_SECRET=
# Canvas modules -> RAG ingestion during sync
RAG_INGESTION_ENABLED=true
RAG_INGEST_MAX_COURSES=1
RAG_REINDEX_HOURS=24
RAG_INGEST_TIMEOUT_MS=180000
RAG_INGEST_MAX_ATTEMPTS=2

# Per-user rate limits for /api/ask (Postgres-backed, minute/day windows)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# HMAC secret shared by the Next.js app and the RAG service.
RAG_SIGNING_SECRET=
