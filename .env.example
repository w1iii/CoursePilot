
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canvas LMS
# Default host shown in the connect form; users supply their own access token.
CANVAS_API_URL=https://canvas.instructure.com
# Encrypts per-user Canvas tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Local development only: allow the shared CANVAS_ACCESS_TOKEN fallback.
CANVAS_ALLOW_ENV_TOKEN=false
CANVAS_ACCESS_TOKEN=

# RAG service (../rag/canvas-ai-assistant)
RAG_API_URL=http://localhost:8000
RAG_API_TOKEN=
RAG_ADMIN_TOKEN=
RAG_TIMEOUT_MS=30000
# Canvas modules -> RAG ingestion during sync
RAG_INGESTION_ENABLED=true
RAG_INGEST_MAX_COURSES=1
RAG_REINDEX_HOURS=24
RAG_INGEST_TIMEOUT_MS=180000
RAG_INGEST_MAX_ATTEMPTS=2
